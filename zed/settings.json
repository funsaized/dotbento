{
  "code_lens": "menu",
  "cli_default_open_behavior": "existing_window",
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "disable_ai": false,
  "edit_predictions": {
    "mode": "subtle",
    "allow_data_collection": "no",
    "provider": "zed"
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "favorite_config_option_values": {
        "reasoning_effort": [
          "medium",
          "high",
          "xhigh"
        ],
        "model": [
          "gpt-6-luna",
          "gpt-6.2-sol",
          "gpt-6.2-astra"
        ]
      },
      "type": "registry",
      "default_config_options": {
        "fast-mode": true,
        "reasoning_effort": "medium",
        "model": "gpt-6-luna"
      }
    }
  },
  "agent": {
    "dock": "right",
    "default_profile": "ask",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "openai",
      "model": "gpt-6-luna"
    },
    "play_sound_when_agent_done": "always",
    "tool_permissions": {
      "default": "allow"
    },
    "inline_assistant_model": {
      "provider": "openai",
      "model": "gpt-6-luna",
      "enable_thinking": true,
      "effort": "low"
    },
    "profiles": {
      "descriptive": {
        "default_model": {
          "provider": "openai",
          "model": "gpt-6-luna",
          "enable_thinking": true,
          "effort": "low"
        },
        "name": "Descriptive",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "favorite_models": [
      {
        "provider": "openai",
        "model": "gpt-6-sol",
        "enable_thinking": true
      },
      {
        "provider": "copilot_chat",
        "model": "claude-sonnet-4.5",
        "enable_thinking": false
      },
      {
        "provider": "copilot_chat",
        "model": "claude-opus-4.6",
        "enable_thinking": false
      },
      {
        "provider": "openai",
        "model": "gpt-6-astra",
        "enable_thinking": true
      }
    ],
    "model_parameters": []
  },
  "agent_buffer_font_size": 16.0,
  "agent_ui_font_size": 16,
  "ui_font_size": 16.0,
  "ui_font_weight": 450,
  "ui_font_family": ".ZedSans",
  "buffer_font_family": "Operator Mono Lig",
  "buffer_font_size": 16.0,
  "buffer_font_weight": 400,
  "buffer_line_height": "comfortable",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Base Charmed Icons",
    "dark": "Catppuccin Latte"
  },
  "theme_overrides": {
    "Catppuccin Mocha": {
      "syntax": {
        "comment": {
          "font_style": "italic"
        },
        "comment.doc": {
          "font_style": "italic"
        },
        "keyword": {
          "font_style": "italic"
        },
        "type.keyword": {
          "font_style": "italic"
        },
        "variable.special": {
          "font_style": "italic"
        },
        "variable.parameter": {
          "font_style": "italic"
        },
        "attribute": {
          "font_style": "italic"
        },
        "type": {
          "font_style": "italic"
        },
        "keyword.import": {
          "font_style": "italic"
        },
        "attribute.decorator": {
          "font_style": "italic"
        },
        "string.escape": {
          "font_style": "italic"
        }
      }
    },
    "Catppuccin Iced Latte (Blur)": {
      "syntax": {
        "comment": {
          "font_style": "italic"
        },
        "comment.doc": {
          "font_style": "italic"
        },
        "keyword": {
          "font_style": "italic"
        },
        "type.keyword": {
          "font_style": "italic"
        },
        "variable.special": {
          "font_style": "italic"
        },
        "variable.parameter": {
          "font_style": "italic"
        },
        "attribute": {
          "font_style": "italic"
        },
        "type": {
          "font_style": "italic"
        },
        "keyword.import": {
          "font_style": "italic"
        },
        "attribute.decorator": {
          "font_style": "italic"
        },
        "string.escape": {
          "font_style": "italic"
        }
      }
    }
  },
  "text_rendering_mode": "platform_default",
  "base_keymap": "Zed",
  "cursor_blink": true,
  "cursor_shape": "underline",
  "current_line_highlight": "all",
  "colorize_brackets": true,
  "soft_wrap": "none",
  "tab_size": 4,
  "show_wrap_guides": true,
  "wrap_guides": [
    80,
    100,
    120
  ],
  "indent_guides": {
    "coloring": "fixed",
    "background_coloring": "disabled"
  },
  "inlay_hints": {
    "enabled": false,
    "show_background": false,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": {
      "control": false,
      "shift": false,
      "alt": true,
      "platform": false,
      "function": false
    }
  },
  "use_smartcase_search": true,
  "restore_on_startup": "last_workspace",
  "autosave": "on_focus_change",
  "linked_edits": true,
  "zoomed_padding": true,
  "active_pane_modifiers": {
    "inactive_opacity": 0.75,
    "border_size": 1.0
  },
  "centered_layout": {
    "right_padding": null,
    "left_padding": null
  },
  "pane_split_direction_horizontal": "down",
  "pane_split_direction_vertical": "right",
  "vim_mode": true,
  "helix_mode": false,
  "vim": {
    "toggle_relative_line_numbers": false,
    "default_mode": "normal",
    "use_system_clipboard": "always"
  },
  "format_on_save": "off",
  "languages": {
    "Python": {
      "colorize_brackets": true,
      "indent_guides": {
        "background_coloring": "disabled"
      }
    },
    "JavaScript": {
      "tab_size": 2,
      "colorize_brackets": true,
      "indent_guides": {
        "background_coloring": "disabled"
      },
      "language_servers": [
        "vtsls",
        "oxlint",
        "oxfmt",
        "!eslint",
        "!biome",
        "!typescript-language-server",
        "..."
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "prettier": {
        "allowed": false
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    },
    "JSX": {
      "tab_size": 2,
      "colorize_brackets": true,
      "language_servers": [
        "vtsls",
        "oxlint",
        "oxfmt",
        "!eslint",
        "!biome",
        "!typescript-language-server",
        "..."
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "prettier": {
        "allowed": false
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    },
    "TypeScript": {
      "tab_size": 2,
      "colorize_brackets": true,
      "indent_guides": {
        "background_coloring": "disabled"
      },
      "language_servers": [
        "vtsls",
        "oxlint",
        "oxfmt",
        "!eslint",
        "!biome",
        "!typescript-language-server",
        "..."
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "prettier": {
        "allowed": false
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    },
    "TSX": {
      "tab_size": 2,
      "colorize_brackets": true,
      "language_servers": [
        "vtsls",
        "oxlint",
        "oxfmt",
        "!eslint",
        "!biome",
        "!typescript-language-server",
        "..."
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "prettier": {
        "allowed": false
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    },
    "C++": {
      "colorize_brackets": true
    },
    "JSON": {
      "tab_size": 2,
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "prettier": {
        "allowed": false
      },
      "language_servers": [
        "oxfmt",
        "..."
      ]
    },
    "JSONC": {
      "tab_size": 2,
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "prettier": {
        "allowed": false
      },
      "language_servers": [
        "oxfmt",
        "..."
      ]
    },
    "CSS": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      }
    },
    "SCSS": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      }
    },
    "HTML": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      }
    },
    "Markdown": {
      "soft_wrap": "editor_width",
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      }
    },
    "Astro": {
      "format_on_save": "off"
    },
    "Dart": {
      "format_on_save": "off"
    },
    "EEx": {
      "format_on_save": "off"
    },
    "Elixir": {
      "format_on_save": "off"
    },
    "Elm": {
      "format_on_save": "off"
    },
    "Go": {
      "format_on_save": "off"
    },
    "GraphQL": {
      "format_on_save": "off"
    },
    "HEEx": {
      "format_on_save": "off"
    },
    "Kotlin": {
      "format_on_save": "off"
    },
    "Rust": {
      "format_on_save": "off"
    },
    "Starlark": {
      "format_on_save": "off"
    },
    "Zig": {
      "format_on_save": "off"
    }
  },
  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": {
          "run": "onType",
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "warn"
        }
      }
    },
    "jdtls": {
      "initialization_options": {
        "settings": {
          "java": {
            "eclipse": {
              "downloadSources": true
            },
            "maven": {
              "downloadSources": true
            },
            "references": {
              "includeDecompiledSources": false
            }
          }
        }
      }
    }
  },
  "terminal": {
    "font_family": "Operator Mono Lig",
    "font_size": 16,
    "font_weight": 400,
    "shell": "system",
    "working_directory": "current_project_directory",
    "dock": "bottom",
    "default_height": 320,
    "option_as_meta": false,
    "blinking": "terminal_controlled",
    "cursor_shape": "underline",
    "keep_selection_on_copy": false,
    "scrollbar": {
      "show": "always"
    },
    "toolbar": {
      "breadcrumbs": false
    },
    "button": true,
    "env": {
      "TERM": "xterm-256color"
    }
  },
  "window_decorations": "client",
  "use_system_window_tabs": false,
  "bottom_dock_layout": "contained",
  "project_panel": {
    "folder_indicator": "chevron",
    "dock": "right",
    "hide_hidden": false,
    "sticky_scroll": true,
    "scrollbar": {
      "show": "auto"
    },
    "indent_size": 12,
    "entry_spacing": "comfortable",
    "hide_root": false,
    "git_status": true,
    "file_icons": true,
    "button": true,
    "hide_gitignore": false
  },
  "tab_bar": {
    "show": true,
    "show_pinned_tabs_in_separate_row": false,
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": true
  },
  "tabs": {
    "show_diagnostics": "all",
    "show_close_button": "hover",
    "close_position": "left",
    "file_icons": true,
    "git_status": true
  },
  "toolbar": {
    "code_actions": true,
    "breadcrumbs": true
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_branch_name": true,
    "show_menus": false,
    "show_sign_in": true,
    "show_user_picture": true
  },
  "status_bar": {
    "cursor_position_button": true,
    "active_language_button": true
  },
  "minimap": {
    "thumb": "always",
    "max_width_columns": 90,
    "display_in": "all_editors",
    "show": "always"
  },
  "outline_panel": {
    "dock": "left",
    "button": true
  },
  "notification_panel": {
    "button": true
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": true
  },
  "debugger": {
    "button": true
  },
  "search": {
    "regex": true,
    "button": true
  },
  "seed_search_query_from_cursor": "always",
  "diagnostics": {
    "button": true
  },
  "git": {
    "branch_picker": {
      "show_author_name": true
    },
    "inline_blame": {
      "enabled": true,
      "show_commit_summary": true,
      "min_column": 80,
      "delay_ms": 600
    }
  },
  "git_panel": {
    "dock": "left",
    "sort_by_path": false,
    "status_style": "label_color",
    "tree_view": true,
    "collapse_untracked_diff": false
  },
  "calls": {
    "mute_on_join": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "file_scan_exclusions": [
    "**/node_modules",
    "**/bower_components",
    "**/vendor",
    "**/.pnp",
    "**/.pnp.js",
    "**/dist",
    "**/out",
    "**/.next",
    "**/.nuxt",
    "**/.output",
    "**/target",
    "**/.cache",
    "**/.turbo",
    "**/.parcel-cache",
    "**/.webpack-cache",
    "**/eslintcache",
    "**/coverage",
    "**/.nyc_output",
    "**/test-results",
    "**/*.min.js",
    "**/*.min.css",
    "**/bundle.js",
    "**/*.map",
    "**/.env.local",
    "**/.env.*.local",
    "**/*.log",
    "**/.idea",
    "**/*.swp",
    "**/*.swo"
  ],
  "relative_line_numbers": "enabled",
  "which_key": {
    "enabled": true,
    "delay_ms": 350
  },
  "auto_install_extensions": {
    "oxc": true,
    "catppuccin": true,
    "catppuccin-icons": true,
    "charmed-icons": true
  }
}
